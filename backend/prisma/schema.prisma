// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Quiz {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  username    String
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  rounds      Round[]
}

model Round {
  id              Int      @id @default(autoincrement())
  quiz            Quiz     @relation(fields: [quiz_id], references: [id])
  quiz_id         Int
  round_number    Int
  max_round_time  Int?
  max_round_score Int
  lat             Float
  lng             Float
  heading         Int
  pitch           Int
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  guess           Guess?
}

model Guess {
  id         Int      @id @default(autoincrement())
  round      Round    @relation(fields: [round_id], references: [id])
  round_id   Int      @unique
  distance   Int?
  score      Int
  lat        Float?
  lng        Float?
  timeout    Boolean
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}
